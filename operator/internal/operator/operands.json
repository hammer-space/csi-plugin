  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "ClusterRoleBinding",
    "metadata": {
      "name": "hammerspace-csi-provisioner"
    },
    "roleRef": {
      "apiGroup": "rbac.authorization.k8s.io",
      "kind": "ClusterRole",
      "name": "hammerspace-csi-provisioner"
    },
    "subjects": [
      {
        "kind": "ServiceAccount",
        "name": "csi-provisioner",
        "namespace": "kube-system"
      }
    ]
  },
  {
    "apiVersion": "apps/v1",
    "kind": "DaemonSet",
    "metadata": {
      "name": "csi-node"
    },
    "spec": {
      "selector": {
        "matchLabels": {
          "app": "csi-node"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "csi-node"
          }
        },
        "spec": {
          "containers": [
            {
              "args": [
                "--v=5",
                "--csi-address=$(CSI_ENDPOINT)",
                "--kubelet-registration-path=$(REG_SOCKET)"
              ],
              "env": [
                {
                  "name": "CSI_ENDPOINT",
                  "value": "/csi/csi.sock"
                },
                {
                  "name": "REG_SOCKET",
                  "value": "/var/lib/kubelet/plugins_registry/com.hammerspace.csi/csi.sock"
                },
                {
                  "name": "KUBE_NODE_NAME",
                  "valueFrom": {
                    "fieldRef": {
                      "apiVersion": "v1",
                      "fieldPath": "spec.nodeName"
                    }
                  }
                }
              ],
              "image": "registry.k8s.io/sig-storage/csi-node-driver-registrar:v2.9.0",
              "imagePullPolicy": "IfNotPresent",
              "name": "driver-registrar",
              "resources": {
                "requests": {
                  "cpu": "10m",
                  "memory": "64Mi"
                }
              },
              "securityContext": {
                "privileged": true
              },
              "volumeMounts": [
                {
                  "mountPath": "/csi",
                  "name": "socket-dir"
                },
                {
                  "mountPath": "/registration",
                  "name": "registration-dir"
                }
              ]
            },
            {
              "args": [
                "--csi-address=$(CSI_ENDPOINT)",
                "--health-port=29793",
                "--probe-timeout=10s"
              ],
              "env": [
                {
                  "name": "CSI_ENDPOINT",
                  "value": "/csi/csi.sock"
                }
              ],
              "image": "registry.k8s.io/sig-storage/livenessprobe:v2.12.0",
              "imagePullPolicy": "IfNotPresent",
              "name": "liveness-probe",
              "resources": {
                "requests": {
                  "cpu": "10m",
                  "memory": "64Mi"
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/csi",
                  "name": "socket-dir"
                }
              ]
            },
            {
              "env": [
                {
                  "name": "CSI_ENDPOINT",
                  "value": "/csi/csi.sock"
                },
                {
                  "name": "HS_USERNAME",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "username",
                      "name": "com.hammerspace.csi.credentials"
                    }
                  }
                },
                {
                  "name": "HS_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "password",
                      "name": "com.hammerspace.csi.credentials"
                    }
                  }
                },
                {
                  "name": "HS_ENDPOINT",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "endpoint",
                      "name": "com.hammerspace.csi.credentials"
                    }
                  }
                },
                {
                  "name": "CSI_NODE_NAME",
                  "valueFrom": {
                    "fieldRef": {
                      "fieldPath": "spec.nodeName"
                    }
                  }
                },
                {
                  "name": "HS_TLS_VERIFY",
                  "value": "false"
                },
                {
                  "name": "CSI_MAJOR_VERSION",
                  "value": "1"
                },
                {
                  "name": "LOG_LEVEL",
                  "value": "info"
                },
                {
                  "name": "OTEL_TRACES_EXPORTER",
                  "value": "none"
                },
                {
                  "name": "OTEL_METRICS_EXPORTER",
                  "value": "prometheus"
                },
                {
                  "name": "OTEL_METRICS_PROMETHEUS_LISTEN",
                  "value": ":9091"
                }
              ],
              "envFrom": [
                {
                  "configMapRef": {
                    "name": "csi-env-config"
                  }
                }
              ],
              "image": "hammerspaceinc/csi-plugin:v1.4.0",
              "imagePullPolicy": "IfNotPresent",
              "livenessProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": "healthz"
                },
                "initialDelaySeconds": 10,
                "periodSeconds": 60,
                "timeoutSeconds": 15
              },
              "name": "hs-csi-plugin-node",
              "ports": [
                {
                  "containerPort": 9091,
                  "hostPort": 9091,
                  "name": "metrics",
                  "protocol": "TCP"
                },
                {
                  "containerPort": 29793,
                  "hostPort": 29793,
                  "name": "healthz",
                  "protocol": "TCP"
                }
              ],
              "resources": {
                "requests": {
                  "cpu": "10m",
                  "memory": "64Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": true,
                "capabilities": {
                  "add": [
                    "SYS_ADMIN"
                  ]
                },
                "privileged": true
              },
              "volumeMounts": [
                {
                  "mountPath": "/csi",
                  "name": "socket-dir"
                },
                {
                  "mountPath": "/registration",
                  "mountPropagation": "Bidirectional",
                  "name": "registration-dir"
                },
                {
                  "mountPath": "/var/lib/kubelet/",
                  "mountPropagation": "Bidirectional",
                  "name": "mountpoint-dir"
                },
                {
                  "mountPath": "/var/lib/hammerspace/",
                  "mountPropagation": "Bidirectional",
                  "name": "rootshare-dir"
                },
                {
                  "mountPath": "/dev",
                  "name": "dev-dir"
                },
                {
                  "mountPath": "/tmp",
                  "mountPropagation": "Bidirectional",
                  "name": "staging-dir"
                }
              ]
            }
          ],
          "dnsPolicy": "ClusterFirstWithHostNet",
          "hostNetwork": true,
          "nodeSelector": {
            "kubernetes.io/os": "linux"
          },
          "serviceAccountName": "csi-node",
          "volumes": [
            {
              "hostPath": {
                "path": "/var/lib/kubelet/plugins_registry/com.hammerspace.csi",
                "type": "DirectoryOrCreate"
              },
              "name": "socket-dir"
            },
            {
              "hostPath": {
                "path": "/var/lib/kubelet/"
              },
              "name": "mountpoint-dir"
            },
            {
              "hostPath": {
                "path": "/var/lib/hammerspace/",
                "type": "DirectoryOrCreate"
              },
              "name": "rootshare-dir"
            },
            {
              "hostPath": {
                "path": "/var/lib/kubelet/plugins_registry/"
              },
              "name": "registration-dir"
            },
            {
              "hostPath": {
                "path": "/dev"
              },
              "name": "dev-dir"
            },
            {
              "hostPath": {
                "path": "/tmp",
                "type": "DirectoryOrCreate"
              },
              "name": "staging-dir"
            }
          ]
        }
      }
    }
  },
