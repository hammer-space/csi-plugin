[
  {
    "apiVersion": "storage.k8s.io/v1",
    "kind": "CSIDriver",
    "metadata": {
      "name": "com.hammerspace.csi"
    },
    "spec": {
      "podInfoOnMount": true,
      "requiresRepublish": true,
      "storageCapacity": true,
      "volumeLifecycleModes": [
        "Persistent"
      ]
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "labels": {
        "app": "csi-provisioner"
      },
      "name": "csi-provisioner"
    },
    "spec": {
      "clusterIP": "None",
      "selector": {
        "app": "csi-provisioner"
      },
      "type": "ClusterIP"
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "StatefulSet",
    "metadata": {
      "name": "csi-provisioner"
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app": "csi-provisioner"
        }
      },
      "serviceName": "csi-provisioner",
      "template": {
        "metadata": {
          "labels": {
            "app": "csi-provisioner"
          }
        },
        "spec": {
          "containers": [
            {
              "args": [
                "--csi-address=$(CSI_ENDPOINT)",
                "--timeout=60s",
                "--v=5",
                "--enable-capacity",
                "--capacity-ownerref-level=1",
                "--capacity-poll-interval=30s",
                "--capacity-threads=4"
              ],
              "env": [
                {
                  "name": "CSI_ENDPOINT",
                  "value": "/var/lib/csi/hs-csi.sock"
                },
                {
                  "name": "NAMESPACE",
                  "valueFrom": {
                    "fieldRef": {
                      "fieldPath": "metadata.namespace"
                    }
                  }
                },
                {
                  "name": "POD_NAME",
                  "valueFrom": {
                    "fieldRef": {
                      "fieldPath": "metadata.name"
                    }
                  }
                }
              ],
              "image": "registry.k8s.io/sig-storage/csi-provisioner:v3.6.0",
              "imagePullPolicy": "IfNotPresent",
              "name": "csi-provisioner",
              "resources": {
                "requests": {
                  "cpu": "10m",
                  "memory": "64Mi"
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/var/lib/csi/",
                  "name": "socket-dir"
                }
              ]
            },
            {
              "args": [
                "--csi-address=$(CSI_ENDPOINT)",
                "--v=5"
              ],
              "env": [
                {
                  "name": "CSI_ENDPOINT",
                  "value": "/var/lib/csi/hs-csi.sock"
                }
              ],
              "image": "registry.k8s.io/sig-storage/csi-attacher:v4.4.0",
              "imagePullPolicy": "IfNotPresent",
              "name": "csi-attacher",
              "resources": {
                "requests": {
                  "cpu": "10m",
                  "memory": "64Mi"
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/var/lib/csi/",
                  "name": "socket-dir"
                }
              ]
            },
            {
              "args": [
                "--csi-address=$(CSI_ENDPOINT)",
                "--v=5"
              ],
              "env": [
                {
                  "name": "CSI_ENDPOINT",
                  "value": "/var/lib/csi/hs-csi.sock"
                }
              ],
              "image": "registry.k8s.io/sig-storage/csi-snapshotter:v6.2.1",
              "imagePullPolicy": "IfNotPresent",
              "name": "csi-snapshotter",
              "resources": {
                "requests": {
                  "cpu": "10m",
                  "memory": "64Mi"
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/var/lib/csi/",
                  "name": "socket-dir"
                }
              ]
            },
            {
              "args": [
                "--csi-address=$(CSI_ENDPOINT)",
                "--v=5"
              ],
              "env": [
                {
                  "name": "CSI_ENDPOINT",
                  "value": "/var/lib/csi/hs-csi.sock"
                }
              ],
              "image": "registry.k8s.io/sig-storage/csi-resizer:v1.14.0",
              "imagePullPolicy": "IfNotPresent",
              "name": "csi-resizer",
              "resources": {
                "requests": {
                  "cpu": "10m",
                  "memory": "64Mi"
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/var/lib/csi/",
                  "name": "socket-dir"
                }
              ]
            },
            {
              "args": [
                "--csi-address=$(CSI_ENDPOINT)",
                "--health-port=29791",
                "--probe-timeout=10s"
              ],
              "env": [
                {
                  "name": "CSI_ENDPOINT",
                  "value": "/var/lib/csi/hs-csi.sock"
                }
              ],
              "image": "registry.k8s.io/sig-storage/livenessprobe:v2.12.0",
              "imagePullPolicy": "IfNotPresent",
              "name": "liveness-probe",
              "resources": {
                "requests": {
                  "cpu": "10m",
                  "memory": "64Mi"
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/var/lib/csi/",
                  "name": "socket-dir"
                }
              ]
            },
            {
              "env": [
                {
                  "name": "CSI_ENDPOINT",
                  "value": "/var/lib/csi/hs-csi.sock"
                },
                {
                  "name": "HS_USERNAME",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "username",
                      "name": "com.hammerspace.csi.credentials"
                    }
                  }
                },
                {
                  "name": "HS_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "password",
                      "name": "com.hammerspace.csi.credentials"
                    }
                  }
                },
                {
                  "name": "HS_ENDPOINT",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "endpoint",
                      "name": "com.hammerspace.csi.credentials"
                    }
                  }
                },
                {
                  "name": "HS_TLS_VERIFY",
                  "value": "false"
                },
                {
                  "name": "CSI_MAJOR_VERSION",
                  "value": "1"
                },
                {
                  "name": "LOG_LEVEL",
                  "value": "info"
                },
                {
                  "name": "OTEL_TRACES_EXPORTER",
                  "value": "none"
                },
                {
                  "name": "OTEL_METRICS_EXPORTER",
                  "value": "prometheus"
                },
                {
                  "name": "OTEL_METRICS_PROMETHEUS_LISTEN",
                  "value": ":9090"
                }
              ],
              "envFrom": [
                {
                  "configMapRef": {
                    "name": "csi-env-config"
                  }
                }
              ],
              "image": "hammerspaceinc/csi-plugin:v1.4.0",
              "imagePullPolicy": "IfNotPresent",
              "livenessProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": "healthz"
                },
                "initialDelaySeconds": 10,
                "periodSeconds": 60,
                "timeoutSeconds": 15
              },
              "name": "hs-csi-plugin-controller",
              "ports": [
                {
                  "containerPort": 9090,
                  "hostPort": 9090,
                  "name": "metrics",
                  "protocol": "TCP"
                },
                {
                  "containerPort": 29791,
                  "hostPort": 29791,
                  "name": "healthz",
                  "protocol": "TCP"
                }
              ],
              "resources": {
                "requests": {
                  "cpu": "10m",
                  "memory": "64Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": true,
                "capabilities": {
                  "add": [
                    "SYS_ADMIN"
                  ]
                },
                "privileged": true
              },
              "volumeMounts": [
                {
                  "mountPath": "/var/lib/csi/",
                  "name": "socket-dir"
                },
                {
                  "mountPath": "/dev",
                  "name": "dev-dir"
                },
                {
                  "mountPath": "/tmp",
                  "mountPropagation": "Bidirectional",
                  "name": "staging-dir"
                },
                {
                  "mountPath": "/var/lib/hammerspace/",
                  "mountPropagation": "Bidirectional",
                  "name": "rootshare-dir"
                }
              ]
            }
          ],
          "dnsPolicy": "ClusterFirstWithHostNet",
          "hostNetwork": true,
          "nodeSelector": {
            "kubernetes.io/os": "linux"
          },
          "serviceAccountName": "csi-provisioner",
          "volumes": [
            {
              "emptyDir": {},
              "name": "socket-dir"
            },
            {
              "hostPath": {
                "path": "/dev"
              },
              "name": "dev-dir"
            },
            {
              "hostPath": {
                "path": "/tmp",
                "type": "DirectoryOrCreate"
              },
              "name": "staging-dir"
            },
            {
              "hostPath": {
                "path": "/var/lib/hammerspace/",
                "type": "DirectoryOrCreate"
              },
              "name": "rootshare-dir"
            }
          ]
        }
      }
    }
  },
  {
