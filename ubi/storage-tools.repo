# Public EL9 packages missing from UBI. Enabled only by install-runtime-packages.sh,
# which excludes every already-installed package from these repositories.
[hs-storage-baseos]
name=Rocky Linux 9 BaseOS storage dependencies
baseurl=https://dl.rockylinux.org/pub/rocky/9/BaseOS/$basearch/os/
enabled=0
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-9
priority=100

[hs-storage-appstream]
name=Rocky Linux 9 AppStream storage dependencies
baseurl=https://dl.rockylinux.org/pub/rocky/9/AppStream/$basearch/os/
enabled=0
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-9
priority=100
